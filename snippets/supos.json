  },
  "scriptUtil.Alert": {
    "prefix": "os-Alert",
    "body": [
      "scriptUtil.Alert('弹出成功', () => {",
      "  console.log('点击确定');",
      "});"
    ],
    "description": "弹窗，有确定和取消按钮"
  },
  "scriptUtil.showMessage": {
    "prefix": "os-showMessage",
    "body": [
      "scriptUtil.showMessage('Message', 'success');"
    ],
    "description": "顶部消息提示"
  },
  "scriptUtil.timestampFormat": {
    "prefix": "os-timestampFormat",
    "body": [
      "scriptUtil.timestampFormat(1587109353040, 'YYYY-MM-DD HH:mm:ss');",
      "// \"2020-04-17 15:42:33\""
    ],
    "description": "时间戳格式化为时间字符串，返回 String"
  },
  "scriptUtil.timestampAntiFormat": {
    "prefix": "os-timestampAntiFormat",
    "body": [
      "scriptUtil.timestampAntiFormat('2021-05-01 01:00:00');",
      "// 1619802000000"
    ],
    "description": "时间字符串转为时间戳，返回 Number"
  },
  "scriptUtil.regRexGroup": {
    "prefix": "os-regRexGroup",
    "body": [
      "const reg = scriptUtil.regRexGroup('mobilePhone');",
      "reg.test('18866668888'); // true",
      "reg.test('1886666777'); // false"
    ],
    "description": "获取对应类型的正则验证规则，返回 RegExp"
  },
  "scriptUtil.isVaild": {
    "prefix": "os-isVaild",
    "body": [
      "scriptUtil.isVaild(['ctrlId1', 'ctrlId2', 'ctrlId3']);"
    ],
    "description": "表单提交时校验组件值格式是否符合设置的规则，返回 Boolean；校验规则在表单元素属性区配置"
  },
  "scriptUtil.getFormatterMap": {
    "prefix": "os-getFormatterMap",
    "body": [
      "scriptUtil.getFormatterMap(['ctrlId1', 'ctrlId2', 'ctrlId3']);"
    ],
    "description": "根据组件 id 获取组件的标题和名称，返回 {组件名称: 组件标题}"
  },
  "scriptUtil.parseTableMap": {
    "prefix": "os-parseTableMap",
    "body": [
      "const data = [{ name: '张三', age: 123 }, { name: '李四', age: 33 }];",
      "const map = { name: '姓名', age: '年龄' };",
      "const result = scriptUtil.parseTableMap(data, map, '序号');",
      "// [{ \"序号\": 1, \"姓名\": \"张三\", \"年龄\": 123 }, ...]"
    ],
    "description": "替换数组内对象的 key，返回处理后的新数组"
  },
  "scriptUtil.objKeySort": {
    "prefix": "os-objKeySort",
    "body": [
      "const data = { name: '张三', age: 123, sex: '男' };",
      "const sort = ['sex', 'age', 'name'];",
      "const result = scriptUtil.objKeySort(data, sort);"
    ],
    "description": "对对象的 key 进行排序，返回处理后的新对象"
  },
  "scriptUtil.getEditRow": {
    "prefix": "os-getEditRow",
    "body": [
      "var result = scriptUtil.getEditRow('表格控件id');"
    ],
    "description": "获取点击的表格行数据，返回 Object"
  },
  "scriptUtil.JSONToExcelConvertor": {
    "prefix": "os-JSONToExcelConvertor",
    "body": [
      "scriptUtil.JSONToExcelConvertor({",
      "  data: [{ name: '小王', age: '12', sex: '女' }],",
      "  dataTitle: ['姓名', '年纪', '性别'],",
      "  dataKey: ['name', 'age', 'sex'],",
      "  fileName: '测试文件',",
      "  extension: 'xls'",
      "});"
    ],
    "description": "用于数据导出 excel 表格"
  },
  "scriptUtil.closeCurrentPage": {
    "prefix": "os-closeCurrentPage",
    "body": [
      "scriptUtil.closeCurrentPage();"
    ],
    "description": "关闭当前窗口"
  },
  "scriptUtil.openPage": {
    "prefix": "os-openPage",
    "body": [
      "// 空页面",
      "scriptUtil.openPage('url', '_blank');",
      "",
      "// 替换当前页面",
      "scriptUtil.openPage('url', '_self');",
      "",
      "// 宽高配置的空页面",
      "scriptUtil.openPage('url', '_blank', true, '{\"height\":400,\"width\":400}');"
    ],
    "description": "打开一个新的浏览器窗口或查找一个已命名的窗口"
  },
  "scriptUtil.showModal": {
    "prefix": "os-showModal",

{
  "scriptUtil.executeScriptService": {
    "prefix": "os-executeScriptService",
    "body": [
      "// 调用模板下服务",
      "var objName = 'namespace.templateName';",
      "// 调用实体模板下对象实例中的服务",
      "var objName = 'namespace.templateName/instanceName';",
      "scriptUtil.executeScriptService({",
      "  objName, // 模板 或者 实例",
      "  serviceName: 'namespace.querySQLExec', // 服务的命名空间+服务别名",
      "  params: {",
      "    // 开发者需要关注后台服务的参数",
      "  },",
      "  version: 'V2',",
      "  cb: function (res) {",
      "    console.log('res', res);",
      "  }",
      "});"
    ],
    "description": "调用对象模板的内置服务或用户自定义的服务"
  },
  "scriptUtil.getRequestUrl": {
    "prefix": "os-getRequestUrl",
    "body": [
      "// 网页地址为 https://www.baidu.com?id=123&code=456",
      "var data = scriptUtil.getRequestUrl();",
      "console.log(data);",
      "// { id: 123, code: 456 }"
    ],
    "description": "获取 url 中 \"?\" 符后的字串，返回 Object"
  },
  "scriptUtil.getTimeZone": {
    "prefix": "os-getTimeZone",
    "body": [
      "// 东八区为 -8",
      "var Offset = scriptUtil.getTimeZone();",
      "console.log(Offset);"
    ],
    "description": "获取当前时区，东八区为 -8，返回 Object"
  },
  "scriptUtil.reload": {
    "prefix": "os-reload",
    "body": [
      "// 50ms 后刷新当前页面",
      "scriptUtil.reload(50);"
    ],
    "description": "延时刷新当前页面"
  },
  "scriptUtil.refreshWorkflow": {
    "prefix": "os-refreshWorkflow",
    "body": [
      "scriptUtil.refreshWorkflow();"
    ],
    "description": "刷新工作流"
  },
  "scriptUtil.copy": {
    "prefix": "os-copy",
    "body": [
      "scriptUtil.copy(any);"
    ],
    "description": "将数据复制到剪切板"
  },
  "scriptUtil.request": {
    "prefix": "os-request",
    "body": [
      "var url = '/api/openapi/notification/v1/message';",
      "var param = {",
      "  method: 'POST', // 请求类型，可选 GET、POST、PUT、DELETE",
      "  body: {}, // 非必填",
      "  headers: {} // 非必填",
      "};",
      "scriptUtil.request(url, param).then((res) => {",
      "  console.log(res);",
      "});"
    ],
    "description": "调用第三方的服务或 supOS 的 openAPI 接口，返回 Promise"
  },
  "scriptUtil.registerReactDom": {
    "prefix": "os-registerReactDom",
    "body": [
      "scriptUtil.registerReactDom(this, this.props);"
    ],
    "description": "在可编程组件中注册自身为一个 ReactDom，可供外部拖拽组件调用其自身方法"
  },
  "scriptUtil.logoutReactDom": {
    "prefix": "os-logoutReactDom",
    "body": [
      "scriptUtil.logoutReactDom(this, this.props);"
    ],
    "description": "注销自身的 ReactDom 实例注册，一般在 componentWillUnmount 生命周期调用以释放内存"
  },
  "scriptUtil.getRegisterReactDom": {
    "prefix": "os-getRegisterReactDom",
    "body": [
      "var reactInstance = scriptUtil.getRegisterReactDom('htdiv-xxxx');",
      "reactInstance.getValue();"
    ],
    "description": "获取已注册组件实例，之后可调用组件内置方法"
  },
  "scriptUtil.getFormData": {
    "prefix": "os-getFormData",
    "body": [
      "scriptUtil.getFormData(['title', 'name', 'age']);"
    ],
    "description": "获取组件的值，用于表单提交一次性获取页面表单数据"
  },
  "scriptUtil.setFormData": {
    "prefix": "os-setFormData",
    "body": [
      "scriptUtil.setFormData({ title: '我的测试数据' });"
    ],
    "description": "设置组件的值，用于表单回填，一次性修改页面表单数据"
  },
  "scriptUtil.submitDefaultValue": {
    "prefix": "os-submitDefaultValue",
    "body": [
      "const component = scriptUtil.getRegisterReactDom('ctrlId');",
      "scriptUtil.submitDefaultValue(component, '查询的值', 1);"
    ],

      "\"url\":\"/#/runtime-fullscreen/runtime-fullscreen/Page_401bf68ecd634809a7cf36fe44b73f59\",",
      "\"sandbox\":\"allow-forms allow-same-origin allow-scripts allow-popups allow-downloads\",",
      "\"isSandbox\":true",
      "}`);"
    ],
    "description": "打开一个新的模态窗口"
  },
  "scriptUtil.closeModal": {
    "prefix": "os-closeModal",
    "body": [
      "scriptUtil.closeModal();"
    ],
    "description": "关闭模态窗口"
  },
  "scriptUtil.closeParentModal": {
    "prefix": "os-closeParentModal",
    "body": [
      "window.parent.scriptUtil.closeModal();"
    ],
    "description": "关闭父页面的模态窗口"
  },
  "scriptUtil.addDataTable": {
    "prefix": "os-addDataTable",
    "body": [
      "const param = {",
      "  'namespace.p1': 'p1',",
      "  'namespace.p2': 'p2'",
      "};",
      "scriptUtil.addDataTable(",
      "  {",
      "    dataSource: 'namespace.tableName',",
      "    properties: [param], // 一定要是 Array 格式",
      "    version: 'V2'",
      "  },",
      "  function (res) {",
      "    console.log('res', res);",
      "  }",
      ");"
    ],
    "description": "新增 DataTable 数据"
  },
  "scriptUtil.delDataTable": {
    "prefix": "os-delDataTable",
    "body": [
      "const param = {",
      "  id: 'xxx' // 只能根据 id 删除",
      "};",
      "scriptUtil.delDataTable(",
      "  {",
      "    dataSource: 'namespace.tableName',",
      "    properties: [param], // 一定要是 Array 格式",
      "    version: 'V2'",
      "  },",
      "  function (res) {",
      "    console.log('res', res);",
      "  }",
      ");"
    ],
    "description": "删除 DataTable 数据"
  },
  "scriptUtil.updateDataTable": {
    "prefix": "os-updateDataTable",
    "body": [
      "// 修改条件：code 字段为 1623219467408",
      "// 修改结果：comDetailAdd（公司详细地址）为浙江省宁波市",
      "var dataSource = 'supyoung_companyreg.company_reg';",
      "var param = {",
      "  comDetailAdd: '浙江省宁波市' // 需要修改的字段",
      "};",
      "var keys = {",
      "  'supyoung_companyreg.code': '1623219467408' // key 必须带命名空间",
      "};",
      "scriptUtil.updateDataTable(",
      "  {",
      "    dataSource,",
      "    properties: [param], // 一定要是 Array 格式",
      "    keys,",
      "    version: 'V2'",
      "  },",
      "  function (res) {",
      "    console.log('res', res);",
      "  }",
      ");"
    ],
    "description": "修改 DataTable 数据"
  },
  "scriptUtil.queryDataTable": {
    "prefix": "os-queryDataTable",
    "body": [
      "var namespace = 'supyoung_companyreg';",
      "var dataSource = namespace + '.company_reg';",
      "scriptUtil.queryDataTable(",
      "  {",
      "    dataSource,",
      "    filters: {",
      "      fields: ['desc'], // 查询指定字段",
      "      order: [",
      "        {",
      "          order: 'code', // 排序的字段",
      "          sort: 'desc' // desc 降序  asc 升序",
      "        }",
      "      ],",
      "      distinct: true,",
      "      pageIndex: 1,",
      "      pageSize: 5,",
      "      'supyoung_companyreg.company': '%xx%' // 查询公司名为 xx 的数据（一定要加上命名空间）",
      "    },",
      "    version: 'V2'",
      "  },",
      "  function (res) {",
      "    console.log('res', res);",
      "  }",
      ");"
    ],
    "description": "查询 DataTable 数据"
  },
  "scriptUtil.callSqlFunction": {
    "prefix": "os-callSqlFunction",
    "body": [
      "// 执行 sql 方法",
      "scriptUtil.callSqlFunction({",
      "  name: 'sqlName',",
      "  params: {",
      "    page: 1, // 分页参数：页码",
      "    per_page: 5 // 分页参数：每页数量",
      "    // 等其他 sql 需要的入参",
      "  },",
      "  enableTotal: false // true 支持查询分页",
      "}).then(function (res) {",
      "  console.log('then:res');",
      "});"
    ],
    "description": "调用「数据查询管理」中的 SQL 脚本，返回 Promise"
  },
  "scriptUtil.getUserInfo": {
    "prefix": "os-getUserInfo",
    "body": [
      "scriptUtil.getUserInfo(function (res) {",
      "  // res 为当前用户的信息",
      "  console.log('res', res);",
      "});"
    ],
    "description": "获取用户信息"
  },
  "scriptUtil.getSessionUserInfo": {
    "prefix": "os-getSessionUserInfo",
    "body": [
      "scriptUtil.getSessionUserInfo();"
    ],
    "description": "从 sessionStorage 获取用户 session 信息，返回 Object"
  },
  "scriptUtil.setAuthority": {
    "prefix": "os-setAuthority",
    "body": [
      "scriptUtil.setAuthority();"
    ],
    "description": "退出登录"
  },
  "$os.api.get": {

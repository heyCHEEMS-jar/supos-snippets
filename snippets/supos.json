      "\\$os.api.get('/api/config/configInfo/global_setting_frentendFn').then((res) => {",
      "  console.log(res);",
      "});"
    ],
    "description": "发起 GET 网络请求，返回 Promise"
  },
  "$os.api.post": {
    "prefix": "os-api-post",
    "body": [
      "\\$os.api.post('/api/config/configInfo/global_setting_frentendFn', { 'context-length': 'json' }).then((res) => {",
      "  console.log(res);",
      "});"
    ],
    "description": "发起 POST 网络请求，返回 Promise"
  },
  "$os.api.put": {
    "prefix": "os-api-put",

      "\\$os.api.put('/api/xxx', { id: 1 }).then((res) => {",
      "  console.log(res);",
      "});"
    ],
    "description": "发起 PUT 网络请求，返回 Promise"
  },
  "$os.api.delete": {
    "prefix": "os-api-delete",
    "body": [
      "\\$os.api.delete('/api/xxx', { id: 1 }).then((res) => {",
      "  console.log(res);",
      "});"
    ],
    "description": "发起 DELETE 网络请求，返回 Promise"
  },
  "$os.dataSave": {
    "prefix": "os-dataSave",
    "body": [
      "// additionalData { code: 123, name: '张三' }，和页面表单组件值一起，存入到表单模板里面",
      "\\$os.dataSave(template, additionalData).then((res) => {",
      "  console.log(res);",
      "});"
    ],
    "description": "获取页面中的表单控件值，插入到表单模板中，返回 Promise"
  },
  "$os.listSave": {
    "prefix": "os-listSave",
    "body": [
      "\\$os.listSave(template, data).then((res) => {",
      "  console.log(res);",
      "});"
    ],
    "description": "批量保存数据至表单模板，返回 Promise"
  },
  "$os.dom": {
    "prefix": "os-dom",
    "body": [
      "\\$os.dom('ctrlId').getValue();"
    ],
    "description": "通过组件 id 或组件名称获取组件实例，调用对应组件的内部方法"
  },
  "$os.dataDelete": {
    "prefix": "os-dataDelete",
    "body": [
      "// 删除表单模板中 age 为 12、code 为 456 的数据",
      "\\$os.dataDelete(template).where('age = 12 and code = 456').then((res) => {",
      "  console.log(res);",
      "});",
      "",
      "\\$os.dataDelete(template).where({ age: 12, code: 456 }).then((res) => {",
      "  console.log(res);",
      "});"
    ],
    "description": "链式调用删除表单模板中数据，链尾 .where() 返回 Promise"
  },
  "$os.dataUpdate": {
    "prefix": "os-dataUpdate",
    "body": [
      "// 将 age 为 12、code 为 456 的数据的 name 字段值改成张三",
      "\\$os.dataUpdate(template)",
      "  .data({ name: '张三' })",
      "  .where('age = 12 and code = 456')",
      "  .then((res) => {",
      "    console.log(res);",
      "  });",
      "",
      "\\$os.dataUpdate(template)",
      "  .data({ name: '张三' })",
      "  .where({ age: 12, code: 456 })",
      "  .then((res) => {",
      "    console.log(res);",
      "  });"
    ],
    "description": "链式调用更新表单模板中的数据，链尾 .where() 返回 Promise"
  },
  "$os.dataQuery": {
    "prefix": "os-dataQuery",
    "body": [
      "\\$os",
      "  .dataQuery(template)",
      "  .where('{age} > 12 and {isDel} <> 0 and {xx} = 123')",
      "  .then((res) => {",
      "    console.log(res);",
      "  });"
    ],
    "description": "链式调用查询表单模板中的数据，链尾 .where() 返回 Promise"
  },
  "$os.execService": {
    "prefix": "os-execService",
    "body": [
      "// 调用表单模板下的服务",
      "\\$os.execService('nameSpace.template', 'serviceName', params).then((res) => {",
      "  console.log(res);",
      "});",
      "",
      "// 调用物模板实例下的服务",
      "\\$os.execService('nameSpace.template.instance', 'serviceName', params).then((res) => {",
      "  console.log(res);",
      "});"
    ],
    "description": "执行服务调用，自动处理模板名称的格式转换，返回 Promise"
  }
}

{
  "name": "supos-snippets",
  "description": "为 supOS 提供的 VS Code 插件，支持可编程组件 API、参数类型提示、代码片段补全。",
  "displayName": "SupOS Snippets",
  "version": "0.0.11",
  "author": "heyCHEEMS",
  "publisher": "heyCHEEMS",
  "license": "ISC",
  "keywords": [
    "intellisense",
    "completion",
    "可编程组件"
  ],
  "engines": {
    "vscode": "^1.137.0"
  },
  "categories": [
    "Snippets",
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:javascriptreact",
    "onLanguage:typescriptreact"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "supos-snippets.generateTypes",
        "title": "%command.generateTypes.title%",
        "category": "SupOS Snippets"
      },
      {
        "command": "supos-snippets.restart",
        "title": "%command.restart.title%",
        "category": "SupOS Snippets"
      }
    ],
    "configuration": {
      "title": "SupOS Snippets",
      "properties": {
        "suposSnippets.typesDir": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "%config.typesDir.description%"
        }
      }
    },
    "snippets": [
      {
        "language": "javascript",
        "path": "./snippets/supos.jsonc"
      },
      {
        "language": "javascriptreact",
        "path": "./snippets/supos.jsonc"
      },
      {
        "language": "typescript",
        "path": "./snippets/supos.jsonc"
      },
      {
        "language": "typescriptreact",
        "path": "./snippets/supos.jsonc"
      }
    ]
  },
  "scripts": {
    "vsce:package": "pnpm vsce package --no-dependencies",
    "vsce:publish": "pnpm vsce publish --no-dependencies",
    "vscode:prepublish": "pnpm package",
    "compile": "pnpm gen && pnpm check-types && pnpm lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "pnpm gen && node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "pnpm gen && pnpm check-types && pnpm lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm compile-tests && pnpm compile && pnpm lint",
    "check-types": "tsc --noEmit",
    "gen": "pnpm gen:snippets && pnpm gen:types",
    "gen:snippets": "node scripts/gen-snippets.mjs",
    "gen:types": "node scripts/gen-types.mjs",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.137.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}